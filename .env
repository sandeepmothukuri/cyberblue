# CyberBlue Environment Configuration
# Copy this file and fill in your values. Never commit real credentials.

MISP_BASE_URL=https://YOUR_SERVER_IP:7003
YETI_AUTH_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
SURICATA_INT=eth0

VEL_USER=admin
VEL_PASSWORD=changeme

######### YETI .ENV ###########
YETI_DOCKER_ENVFILE=.env
YETI_REDIS_HOST=yeti-redis
YETI_REDIS_PORT=6379
YETI_REDIS_DATABASE=0
YETI_ARANGODB_HOST=yeti-arangodb
YETI_ARANGODB_PORT=8529
YETI_ARANGODB_DATABASE=yeti
YETI_ARANGODB_USERNAME=root
YETI_ARANGODB_PASSWORD=changeme
YETI_AUTH_ALGORITHM=HS256
YETI_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
YETI_AUTH_BROWSER_TOKEN_EXPIRE_MINUTES=43200
YETI_AUTH_ENABLED=True
######### END of YETI .ENV ########

ARKIME_ADMIN_PASSWORD=changeme
ARKIME_HOSTNAME=localhost
CAPTURE=off
ARKIME_INTERFACE=eth0
VIEWER=on

# OpenSearch settings
OS_VERSION=2
OS_NODE1=os01
OS_JAVA_MEM=512m
ARKIME_PORT=8005
PCAP_DIR=./arkime/pcaps

###### MISP .ENV #######
CORE_TAG=v2.5.14
MODULES_TAG=v3.0.2
PHP_VER=20220829
PYPI_SETUPTOOLS==80.3.1
PYPI_SUPERVISOR==4.2.5
ADMIN_EMAIL=admin@admin.test
ADMIN_ORG=SOC Lab
ADMIN_ORG_UUID=
ADMIN_KEY=
ADMIN_PASSWORD=changeme
GPG_PASSPHRASE=
CRON_USER_ID=
ENABLE_DB_SETTINGS=
ENCRYPTION_KEY=
ENABLE_BACKGROUND_UPDATES=
##### END of MISP .ENV ######

# Shuffle configuration
ORG_ID=Shuffle
ENVIRONMENT_NAME=Shuffle
SHUFFLE_APP_DOWNLOAD_LOCATION=https://github.com/shuffle/python-apps
SHUFFLE_APP_FORCE_UPDATE=false
SHUFFLE_DEFAULT_USERNAME=
SHUFFLE_DEFAULT_PASSWORD=
SHUFFLE_DEFAULT_APIKEY=
SHUFFLE_APP_HOTLOAD_FOLDER=./shuffle-apps
SHUFFLE_APP_HOTLOAD_LOCATION=./shuffle-apps
SHUFFLE_FILE_LOCATION=./shuffle-files
SHUFFLE_ENCRYPTION_MODIFIER=
BASE_URL=http://shuffle-backend:5001
SSO_REDIRECT_URL=http://localhost:3001
BACKEND_HOSTNAME=shuffle-backend
BACKEND_PORT=5001
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=7002
OUTER_HOSTNAME=shuffle-backend
DB_LOCATION=./shuffle-database
DOCKER_API_VERSION=1.40
TZ=Europe/Amsterdam
SHUFFLE_SKIPSSL_VERIFY=true
IS_KUBERNETES=false
SHUFFLE_BASE_IMAGE_REPOSITORY=frikky
SHUFFLE_CONTAINER_AUTO_CLEANUP=true
SHUFFLE_ORBORUS_EXECUTION_CONCURRENCY=5
SHUFFLE_ELASTIC=true
DATASTORE_EMULATOR_HOST=shuffle-database:8000
SHUFFLE_OPENSEARCH_URL=https://shuffle-opensearch:9200
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true
SHUFFLE_OPENSEARCH_USERNAME=admin
SHUFFLE_OPENSEARCH_PASSWORD=changeme
OPENSEARCH_INITIAL_ADMIN_PASSWORD=changeme

# CyberBlue runtime
CYBERBLUE_INSTALL_DIR=/opt/cyberblue
CYBERBLUE_INSTALL_USER=ubuntu

DEBUG_MODE=false
